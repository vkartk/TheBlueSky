{
  "Routes": [
    {
      "UpstreamPathTemplate": "/gateway/auth/{path}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "DownstreamPathTemplate": "/api/{path}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "auth",
          "Port": 8080
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/gateway/bookings/{path}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "DownstreamPathTemplate": "/api/{path}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "bookings",
          "Port": 8080
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/gateway/flights/{path}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "DownstreamPathTemplate": "/api/{path}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "flights",
          "Port": 8080
        }
      ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://gateway:8080",
    "RequestIdKey": "X-Request-Id"
  }
}